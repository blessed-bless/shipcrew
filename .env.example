# LLM (OpenAI-compatible / OpenRouter). Empty key + DEMO_MODE=true uses fixtures.
SHIPCREW_LLM_BASE_URL=https://api.openai.com/v1
SHIPCREW_LLM_API_KEY=
SHIPCREW_LLM_MODEL=gpt-4o-mini
SHIPCREW_DEMO_MODE=true

# Persistent data (projects, SQLite index, ship bundles)
SHIPCREW_DATA_DIR=./data

# API bind
SHIPCREW_HOST=127.0.0.1
SHIPCREW_PORT=8787

# Orchestrator / HTTP timeouts
SHIPCREW_MAX_REVIEW_ROUNDS=2
SHIPCREW_REQUEST_TIMEOUT_S=120
SHIPCREW_RUNNER_TIMEOUT_S=600

# OAuth return URL (Vite dev or built UI) and public API origin for callbacks
SHIPCREW_FRONTEND_URL=http://127.0.0.1:5173
SHIPCREW_PUBLIC_BASE_URL=http://127.0.0.1:8787
